{
  "name": "paper-polish",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "author": "PaperPolish contributors",
  "description": "论文打磨客户端 - Paper Polishing Client",
  "main": "dist-electron/main/index.js",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit --composite false -p tsconfig.web.json && tsc --noEmit --composite false -p tsconfig.node.json",
    "privacy:check": "node scripts/privacy-check.cjs",
    "test:privacy": "node --test scripts/privacy-check.test.cjs",
    "test": "node --test scripts/privacy-check.test.cjs scripts/runtime.test.cjs",
    "build": "npm run privacy:check && npm run typecheck && vite build",
    "start": "vite",
    "build:win": "npm run build && electron-builder --win --x64 --config --publish never",
    "release:prepare": "node scripts/prepare-release.cjs",
    "preview": "vite preview",
    "postinstall": "electron-builder install-app-deps"
  },
  "dependencies": {
    "better-sqlite3": "^12.6.2",
    "lucide-react": "^0.460.0",
    "ml-distance": "^4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "reactflow": "^11.11.4",
    "remark-gfm": "^4.0.0",
    "uuid": "^13.0.0",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@electron/asar": "^3.4.1",
    "@electron/rebuild": "^4.0.3",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.10.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "7zip-bin": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.2.1",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6",
    "wait-on": "^9.0.4"
  }
}
